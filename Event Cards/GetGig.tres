id = "ev006"
title = "Get Gig"
description = "Time to call up the venue to see if you can play this Saturday night. The promotor looks at you dubiously. "
requirements = "have a band"
difficulty = 10
outcomes = Array[String](["Amazing! Looks like you'll be headlining.", "Awesome! The promotor has a spot for you. ", "You have been rejected. Maybe next time. ", "The promotor hangs up on you and this venue is closed for now. "])
